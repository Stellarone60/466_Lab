/**
 * Display the outputs from the line sensors on the
 * <a href="https://www.pololu.com/docs/0J86">Pololu 3pi+ 2040 robot</a>. This program spends the
 * first 10 seconds in calibration mode, during which you should move the robot over the light and
 * dark areas that you would like it to detect. It then switches into measurement mode and displays
 * the measured reflectance of the five IR sensors.
 *
 * @author Abhi Gundrala
 * @author Edward A. Lee
 */
target C {
  platform: {
    name: "rp2040",
    board: "pololu_3pi_2040_robot"
  },
  single-threaded: true,
  keepalive: true
}

import Display from "lib/Display.lf"

preamble {=
    #include <stdio.h>
    #include <pico/stdlib.h>
    #include <hardware/gpio.h>
    =}

main reactor{
    disp = new Display()
    
    preamble {=
    static void* action;
    void new_callback_function(uint gpio, uint32_t event_mask)
    {
        lf_schedule(action, 0);
    }

    =}
        physical action a
        state counter: int = 0
        timer t(0, 250ms)
        timer t2(0, 500ms)

    reaction(startup) -> a {=
        gpio_init(PICO_DEFAULT_LED_PIN);
        gpio_set_dir(PICO_DEFAULT_LED_PIN, GPIO_IN);
        gpio_pull_up(PICO_DEFAULT_LED_PIN);
        gpio_set_irq_enabled_with_callback(25, GPIO_IRQ_EDGE_FALL, true, new_callback_function);
        action = a;
        =}

    initial mode countUp
    {
        // Switch to counting down when triggered
        reaction(a) -> history(countDown) {=
            lf_set_mode(countDown);
        =}

        // Increment and print count
        reaction(t) -> disp.line0 {=
            self->counter += 1;
            static char timestr[17];
            snprintf(timestr, 17, "%d", self->counter);
            lf_set(disp.line0, timestr);
        =}
    }
    mode countDown
    {
        // Switch to counting up when triggered
        reaction(a) -> history(countUp) {=
        lf_set_mode(countUp);
        =}
        
        // Decrement and print count
        reaction(t2) -> disp.line0{=
            self->counter--;
            static char timestr[17];
            snprintf(timestr, 17, "%d", self->counter);
            lf_set(disp.line0, timestr);
        =}
    }
}