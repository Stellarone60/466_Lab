/**
 * Display the outputs from the line sensors on the
 * <a href="https://www.pololu.com/docs/0J86">Pololu 3pi+ 2040 robot</a>. This program spends the
 * first 10 seconds in calibration mode, during which you should move the robot over the light and
 * dark areas that you would like it to detect. It then switches into measurement mode and displays
 * the measured reflectance of the five IR sensors.
 *
 * @author Abhi Gundrala
 * @author Edward A. Lee
 */
target C {
  platform: {
    name: "rp2040",
    board: "pololu_3pi_2040_robot"
  },
  single-threaded: true
}

import Line from "lib/Line.lf"
import Display from "lib/Display.lf"
import MotorsWithFeedback from "lib/MotorsWithFeedback.lf"
import Tilt from "lib/Tilt.lf"
import Encoders from "lib/Encoders.lf"
import Gyro from "lib/IMU.lf"

main reactor(calibration_time: time = 10 s, sample_period: time = 100 ms) {
  line = new Line()
  disp = new Display()
  motors = new MotorsWithFeedback()
  encoders = new Encoders()
  tilt = new Tilt()
  gyro = new Gyro()

  encoders.right -> motors.right
  encoders.left -> motors.left

  timer t(0, sample_period)
  timer end_calibration(calibration_time)
  state count: int = 0
  state dir: int = 0
  state gyro_turn_initial: float = 0

  reaction(startup) -> disp.line0, disp.line1, disp.line2 {=
    lf_set(disp.line0, "CALIBRATING");
    lf_set(disp.line1, "Roll robot over");
    lf_set(disp.line2, "light and dark.");
  =}

  reaction(end_calibration) -> line.calibrate {=
    lf_set(line.calibrate, false);
  =}

  reaction(t) -> line.trigger, tilt.trigger, encoders.trigger, gyro.trigger {=
    lf_set(line.trigger, true);
    lf_set(tilt.trigger, true);
    lf_set(encoders.trigger, true);
    lf_set(gyro.trigger, true);
  =}

  reaction(line.reflect) -> disp.line0, disp.line1, disp.line2, disp.line3, motors.left_speed, motors.right_speed {=
    const int DARK_THRESH = 600;

    static char buf0[17];
    static char buf1[17];
    static char buf2[17];

    bool left = line.reflect->value[0] > DARK_THRESH || line.reflect->value[1] > DARK_THRESH;
    bool center = line.reflect->value[1] > DARK_THRESH || line.reflect->value[2] > DARK_THRESH || line.reflect->value[3] > DARK_THRESH;
    bool right = line.reflect->value[3] > DARK_THRESH || line.reflect->value[4] > DARK_THRESH;

    snprintf(buf0, 17, "0:%2d 1:%2d 2:%2d", line.reflect->value[0] / 100, line.reflect->value[1] / 100, line.reflect->value[2] / 100);
    snprintf(buf1, 17, "3:%2d 4:%2d %s", line.reflect->value[3] / 100, line.reflect->value[4] / 100, left ? "LEFT" : "");
    snprintf(buf2, 17, "%s %s", center ? "CENTER" : "      ", right ? "RIGHT" : "");
    lf_set(disp.line0, buf0);
    lf_set(disp.line1, buf1);
    lf_set(disp.line2, buf2);

    if (left) {
      self->dir = -1;
    }

    if (center || right) {
      self->dir = 1;
    }
  =}

  initial mode CALIBRATE {
    timer calibrate_timer(0, calibration_time)
    reaction(calibrate_timer) -> reset(DRIVING_UP), motors.right_speed, motors.left_speed {=
      lf_set_mode(DRIVING_UP);
      lf_set(motors.right_speed, 0.1f);
      lf_set(motors.left_speed, 0.1f);
    =}
  }

  mode DRIVING_UP {
    timer detect_timer(0, sample_period)
    reaction(detect_timer, tilt.roll, tilt.pitch, gyro.z) -> reset(BACK_UP), reset(TURNING_AROUND), reset(CORRECT_PITCH_UP), disp.line3, motors.left_speed, motors.right_speed {=
      float roll = tilt.roll->value;
      float pitch = tilt.pitch->value;
      int pitch_sign = pitch > 0 ? 1 : -1;
      
      if (pitch < 2) {
        lf_set_mode(TURNING_AROUND);
        self->gyro_turn_initial = gyro.z->value;
        lf_set(motors.right_speed, -0.1f);
        lf_set(motors.left_speed, 0.1f);
        lf_set(disp.line3, "TURNING_AROUND");
      }

      float left_speed = 0.1f - 0.2f * (roll / 90);
      float right_speed = 0.1f + 0.2f * (roll / 90);
      lf_set(motors.left_speed, left_speed);
      lf_set(motors.right_speed, right_speed);

      static char buf0[17];
      snprintf(buf0, 17, "l:%1.2f r:%1.2f", left_speed, right_speed);
      lf_set(disp.line3, buf0);
      
      if (pitch_sign < 0) {
        lf_set_mode(CORRECT_PITCH_UP);
        int roll_sign = roll > 0 ? 1 : -1;
        lf_set(motors.left_speed, -0.1f * roll_sign);
        lf_set(motors.right_speed, 0.1f * roll_sign);
      }

      if (self->dir != 0) {
        lf_set_mode(BACK_UP);
        lf_set(motors.right_speed, -0.1f);
        lf_set(motors.left_speed, -0.1f);
        lf_set(disp.line3, "BACK_UP");
      }
    =}
  }

  mode CORRECT_PITCH_UP {
    timer pitch_timer(0 s, 1 s)

    reaction(pitch_timer, tilt.pitch, gyro.z) -> reset(DRIVING_UP), reset(TURNING_AROUND), disp.line3, motors.left_speed, motors.right_speed {=
      if (tilt.pitch->value < 2) {
        lf_set_mode(TURNING_AROUND);
        self->gyro_turn_initial = gyro.z->value;
        lf_set(motors.right_speed, -0.1f);
        lf_set(motors.left_speed, 0.1f);
        lf_set(disp.line3, "TURNING_AROUND");
      }
      
      int pitch_sign = tilt.pitch->value > 0 ? 1 : -1;
      if (pitch_sign > 0) {
        lf_set_mode(DRIVING_UP);
      }
    =}
  }
  
  mode TURNING_UP {
    timer turn_timer(1 s, 1 s)

    reaction(turn_timer) -> reset(DRIVING_UP), disp.line3, motors.left_speed, motors.right_speed {=
      lf_set_mode(DRIVING_UP);
      lf_set(motors.right_speed, 0.1f);
      lf_set(motors.left_speed, 0.1f);
      lf_set(disp.line3, "DRIVING_UP");
      self->dir = 0;
    =}
  }

  mode BACK_UP {
    timer back_timer(1 s, 1 s)
    reaction(back_timer) -> reset(TURNING_UP), disp.line3, motors.left_speed, motors.right_speed {=
      lf_set_mode(TURNING_UP);
      lf_set(motors.right_speed, self->dir * 0.1f);
      lf_set(motors.left_speed, -self->dir * 0.1f);
      lf_set(disp.line3, "TURNING_UP");
    =}
  }

  mode TURNING_AROUND {
    timer turning_timer(0, sample_period)
    reaction(turning_timer, gyro.z) -> reset(DRIVING_DOWN), disp.line2 {=
      static char buf0[17];
      snprintf(buf0, 17, "gyro:%3.3f", gyro.z->value);
      lf_set(disp.line2, buf0);
      
      if (fabsf(gyro.z->value - self->gyro_turn_initial) > 180) {
        lf_set_mode(DRIVING_DOWN);
      }
    =}
  }
  
  mode DRIVING_DOWN {
    timer detect_timer2(0, sample_period)
    reaction(detect_timer2, tilt.roll, tilt.pitch, gyro.z) -> reset(BACK_DOWN), reset(STOP), reset(CORRECT_PITCH_DOWN), disp.line3, motors.left_speed, motors.right_speed {=
      float roll = tilt.roll->value;
      float pitch = tilt.pitch->value;
      int pitch_sign = pitch > 0 ? 1 : -1;
      
      if (pitch < 2) {
        lf_set_mode(STOP);
        lf_set(motors.right_speed, 0.0f);
        lf_set(motors.left_speed, 0.0f);
        lf_set(disp.line3, "STOP");
      }

      float left_speed = 0.1f - 0.2f * (roll / 90);
      float right_speed = 0.1f + 0.2f * (roll / 90);
      lf_set(motors.left_speed, left_speed);
      lf_set(motors.right_speed, right_speed);

      static char buf0[17];
      snprintf(buf0, 17, "l:%1.2f r:%1.2f", left_speed, right_speed);
      lf_set(disp.line3, buf0);
      
      if (pitch_sign > 0) {
        lf_set_mode(CORRECT_PITCH_DOWN);
        int roll_sign = roll > 0 ? 1 : -1;
        lf_set(motors.left_speed, -0.1f * roll_sign);
        lf_set(motors.right_speed, 0.1f * roll_sign);
      }

      if (self->dir != 0) {
        lf_set_mode(BACK_DOWN);
        lf_set(motors.right_speed, -0.1f);
        lf_set(motors.left_speed, -0.1f);
        lf_set(disp.line3, "BACK_DOWN");
      }
    =}
  }

  mode TURNING_DOWN {
    timer turn_timer2(1 s, 1 s)

    reaction(turn_timer2) -> reset(DRIVING_DOWN), disp.line3, motors.left_speed, motors.right_speed {=
      lf_set_mode(DRIVING_DOWN);
      lf_set(motors.right_speed, 0.1f);
      lf_set(motors.left_speed, 0.1f);
      lf_set(disp.line3, "DRIVING_DOWN");
      self->dir = 0;
    =}
  }

  mode CORRECT_PITCH_DOWN {
    timer pitch_timer2(0 s, 1 s)

    reaction(pitch_timer2, tilt.pitch) -> reset(DRIVING_DOWN), reset(STOP), disp.line3, motors.left_speed, motors.right_speed {=
      if (tilt.pitch->value < 2) {
        lf_set_mode(STOP);
        lf_set(motors.right_speed, 0.0f);
        lf_set(motors.left_speed, 0.0f);
        lf_set(disp.line3, "STOP");
      }
      
      int pitch_sign = tilt.pitch->value > 0 ? 1 : -1;
      if (pitch_sign < 0) {
        lf_set_mode(DRIVING_DOWN);
      }
    =}
  }

  mode BACK_DOWN {
    timer back_timer2(1 s, 1 s)
    reaction(back_timer2) -> reset(TURNING_DOWN), disp.line3, motors.left_speed, motors.right_speed {=
      lf_set_mode(TURNING_DOWN);
      lf_set(motors.right_speed, self->dir * 0.1f);
      lf_set(motors.left_speed, -self->dir * 0.1f);
      lf_set(disp.line3, "TURNING_DOWN");
    =}
  }

  mode STOP {

  }
}
