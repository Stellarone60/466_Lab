target C {
  platform: {
    name: "rp2040",
    board: "pololu_3pi_2040_robot"
  },
  single-threaded: true
}

import Accelerometer from "IMU.lf"

preamble {=
  #include <math.h>
=}

reactor Tilt {
    a = new Accelerometer()
    input trigger : bool
    output pitch : double
    output roll : double

    reaction(trigger) -> a.trigger {=
        lf_set(a.trigger, true);
    =}

    reaction(a.x, a.y, a.z) -> pitch, roll {=
        // Radians to degrees constant
        const double rad2deg = 180 / M_PI;

        // Use atan2 to calculate the angles in radians
        lf_set(pitch, atan2(a.x->value, a.z->value) * rad2deg);
        lf_set(roll, atan2(a.y->value, a.z->value) * rad2deg);
    =}
}