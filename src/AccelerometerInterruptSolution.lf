/**
 * Display three dimensions of accelerometer measurements on the LCD display of the
 * <a href="https://www.pololu.com/docs/0J86">Pololu 3pi+ 2040 robot</a>. To run this program, first
 * put the robot in BOOTSEL mode (hold button B while resetting). Then the sequence of commands is
 * something like this:
 * ```
 *     $ cd ~/lf-pico
 *     $ lfc src/AccelerometerDisplay.lf
 *     ...
 *     $ picotool load -x bin/AccelerometerDisplay.elf
 * ```

 *
 * This compiles the program, loads it into flash memory on the robot, and begins executing it.
 *
 * @author Edward A. Lee
 */
target C {
  platform: "RP2040",
  single-threaded: true
}

import Accelerometer from "lib/IMU.lf"
import Display from "lib/Display.lf"

preamble {=
    #include <math.h>
    =}

main reactor {

    reaction(startup) {=
    gpio_init(PICO_DEFAULT_LED_PIN);
    gpio_set_dir(PICO_DEFAULT_LED_PIN, GPIO_OUT);
  =}

  a = new Accelerometer()
  d = new Display()
    timer t(0, 250 msec)
    state led_on: bool = false

    reaction(t) -> a.trigger {=
        lf_set(a.trigger, true);
        =}
        

  initial mode active{

    reaction(a.x, a.y, a.z) -> d.line0, d.line1, d.line2, inactive {=
    /// TODO: define max string size for line
    /// based on font you can have 4 or 8 lines
    static char buf0[17];
    static char buf1[17];
    static char buf2[17];

    snprintf(buf0, 17, "x:%2.4f", a.x->value);
    snprintf(buf1, 17, "y:%2.4f", a.y->value);
    snprintf(buf2, 17, "z:%2.4f", a.z->value);

    lf_set(d.line0, buf0);
    lf_set(d.line1, buf1);
    lf_set(d.line2, buf2);

    float total_g = a.x->value * a.x->value + a.y->value * a.y->value + a.z->value * a.z->value;
    total_g = sqrtf(total_g);
    total_g -= 1;
    total_g = fabsf(total_g);
    if(total_g <=.1)
    {
        self->led_on = !self->led_on;
        gpio_put(PICO_DEFAULT_LED_PIN, self->led_on);
        lf_set_mode(inactive);
    }
  =}

  }
  mode inactive{

    reaction(a.x, a.y, a.z) -> active, d.line0, d.line1, d.line2 {=
    static char buf0[17];
    static char buf1[17];
    static char buf2[17];

    snprintf(buf0, 17, "x:%2.4f", a.x->value);
    snprintf(buf1, 17, "y:%2.4f", a.y->value);
    snprintf(buf2, 17, "z:%2.4f", a.z->value);

    lf_set(d.line0, buf0);
    lf_set(d.line1, buf1);
    lf_set(d.line2, buf2);

    float total_g = a.x->value * a.x->value + a.y->value * a.y->value + a.z->value * a.z->value;
    total_g = sqrtf(total_g);
    total_g -= 1;
    total_g = fabsf(total_g);
    if(total_g >=.1)
    {
        self->led_on = !self->led_on;
        gpio_put(PICO_DEFAULT_LED_PIN, self->led_on);
        lf_set_mode(active);
    }
  =}

  }
}
